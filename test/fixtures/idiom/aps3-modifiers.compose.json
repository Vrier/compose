  "exercises": [
    {
      "id": "A",
      "title": "A. Rules of §3.4–3.7",
      "derivations": [
        {
          "id": "pp-np",
          "sentence": "Jack discussed a wedding in Boston.",
          "tree": "[.VP [.DP a_x [.NP wedding [.PP in Boston ] ] ] [.VP Jack [.V′ discussed x ] ] ]",
          "targets": [
            "[∃x: (Wedding ⊓ In(Boston))(x)](Discussed(x)(Jack))"
          ]
        },
        {
          "id": "adverb",
          "sentence": "Jack sang quietly.",
          "tree": "[.VP Jack [.V′ sang quietly ] ]",
          "targets": [
            "(Sang ⊓ Quiet)(Jack)"
          ]
        },
        {
          "id": "relcl",
          "sentence": "Jack met every actor who Sue likes.",
          "tree": "[.VP [.DP every_z [.NP actor [.CP who_x [.VP Sue [.V′ likes x ] ] ] ] ] [.VP Jack [.V′ met z ] ] ]",
          "targets": [
            "[∀z: (Actor ⊓ λx.Likes(x)(Sue))(z)](Met(z)(Jack))"
          ]
        },
        {
          "id": "conj",
          "sentence": "Maria sings and Fred dances.",
          "tree": "[.VP [.VP Maria sings ] and [.VP Fred dances ] ]",
          "targets": [
            "(Sings(Maria) & Dances(Fred))"
          ]
        },
        {
          "id": "bound",
          "sentence": "No girl submitted a story about herself.",
          "tree": "[.VP [.DP no_x girl ] [.VP [.DP a_y [.NP story [.PP about herself_x ] ] ] [.VP x [.V′ submitted y ] ] ] ]",
          "targets": [
            "[No x: Girl(x)]([∃y: (Story ⊓ About(x))(y)](Submitted(y)(x)))"
          ]
        },
        {
          "id": "free",
          "sentence": "She smiled.",
          "tree": "[.VP she_y smiled ]",
          "targets": [
            "Smiled(y)"
          ]
        },
        {
          "id": "the",
          "sentence": "Henry opened the bottle.",
          "tree": "[.VP [.DP the_x bottle ] [.VP Henry [.V′ opened x ] ] ]",
          "targets": [
            "[The x: Bottle(x)](Opened(x)(Henry))"
          ]
        },
        {
          "id": "in-situ",
          "sentence": "Every actor sang.",
          "tree": "[.VP [.DP every_x actor ] sang ]"
        }
      ]
    }
  ]
