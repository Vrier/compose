    {
      "key": "aps4.1-events",
      "title": "Events and Thematic Roles (§4.1–4.2, §4.6)",
      "content": {
        "compose": 1,
        "id": "aps4.1-events",
        "idiom": "aps",
        "title": "Events and Thematic Roles (§4.1–4.2, §4.6)",
        "subtitle": "Altshuler, Parsons & Schwarzschild: thematic roles, the event phrase and EvExist, with each structure given",
        "meta": {
          "source": "after Altshuler, Parsons & Schwarzschild, A Course in Semantics (MIT Press, 2019)"
        },
        "domain": {
          "multiLetterNames": true,
          "constants": {
            "e": "Jack Jill Boston",
            "<e,t>": "Wedding Called Discussed Tourist Smiled Event",
            "<e,<e,t>>": "Agent Patient In"
          },
          "variables": {
            "e": "x y z e s"
          }
        },
        "lexicon": [
