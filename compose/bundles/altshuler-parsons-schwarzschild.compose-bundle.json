    {
      "key": "aps3.2-quantifiers",
      "title": "Translation and Quantificational Determiner Phrases (§3.2–3.3)",
      "content": {
        "compose": 1,
        "id": "aps3.2-quantifiers",
        "idiom": "aps",
        "title": "Translation and Quantificational Determiner Phrases (§3.2–3.3)",
        "subtitle": "Altshuler, Parsons & Schwarzschild: Lexicon, Merge, IndexedDaughter and the Wellformedness Filter, with each LF given",
        "meta": {
          "source": "after Altshuler, Parsons & Schwarzschild, A Course in Semantics (MIT Press, 2019)",
          "tags": [
            "pilot"
          ]
        },
        "domain": {
          "multiLetterNames": true,
          "constants": {
            "e": "Bruce Jack Jill Henry Agatha",
            "<e,t>": "Sang Sing Computer Crashed Bottle Fell Dish Giraffe Person Character Survived",
