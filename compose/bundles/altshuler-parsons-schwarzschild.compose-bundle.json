        },
        "exercises": [
          {
            "id": "A",
            "title": "A. Adverbs and prepositional phrases (§3.4)",
            "instructions": "PredCon conjoins the translations of two one-place predicates: {α, β} ⇝ (α′ ⊓ β′). The adverb quietly translates as a one-place predicate (figure 3.33). A preposition translates as a two-place predicate, and Merge with its object gives a one-place predicate.",
            "derivations": [
              {
                "id": "d1",
                "sentence": "Jack sang quietly.",
                "tree": "[.VP Jack [.V′ sang quietly ] ]",
                "targets": [
                  "(Sang ⊓ Quiet)(Jack)"
                ],
                "reading": {
                  "section": "3.4"
                }
              },
              {
                "id": "d2",
                "sentence": "Jack discussed a wedding in Boston.",
                "tree": "[.VP [.DP a_x [.NP wedding [.PP in Boston ] ] ] [.VP Jack [.V′ discussed x ] ] ]",
                "targets": [
                  "[∃x: (Wedding ⊓ In(Boston))(x)](Discussed(x)(Jack))"
                ],
                "reading": {
                  "section": "3.4"
                }
              }
            ]
          },
          {
            "id": "B",
            "title": "B. Relative clauses (§3.5)",
            "instructions": "RelPro forms a one-place predicate from a formula: {who_u, α} ⇝ λu.α′ (59). In the tree who carries the index x, and x stands in object position (figure 3.37). PredCon conjoins the result with the translation of the noun.",
            "derivations": [
              {
                "id": "d1",
                "sentence": "Jack met every actor who Sue likes.",
                "tree": "[.VP [.DP every_z [.NP actor [.CP who_x [.VP Sue [.V′ likes x ] ] ] ] ] [.VP Jack [.V′ met z ] ] ]",
                "targets": [
                  "[∀z: (Actor ⊓ λx.Likes(x)(Sue))(z)](Met(z)(Jack))"
                ],
                "reading": {
                  "section": "3.5"
                }
              }
            ]
          },
          {
            "id": "C",
            "title": "C. Coordination (§3.6)",
            "instructions": "Conjunction translates a node with the three daughters and, α, β as (α′ & β′).",
            "derivations": [
              {
                "id": "d1",
                "sentence": "Maria sings and Fred dances.",
                "tree": "[.VP [.VP Maria sings ] and [.VP Fred dances ] ]",
                "targets": [
                  "(Sings(Maria) & Dances(Fred))"
                ],
                "reading": {
                  "section": "3.6"
                }
              }
            ]
          },
          {
            "id": "D",
            "title": "D. Pronouns (§3.7)",
            "instructions": "Pronoun translates a pronoun indexed u as u (71). In the first tree herself has the index of the raised phrase every musician, and the quantifier binds it (figure 3.44). In the second tree no quantifier binds y (figure 3.45). The variable stays free in the translation, and the context lexicon gives its value (§3.7.2).",
            "derivations": [
              {
                "id": "d1",
                "sentence": "Every musician nominated herself.",
                "tree": "[.VP [.DP every_y musician ] [.VP y [.V′ nominated herself_y ] ] ]",
                "targets": [
                  "[∀y: Musician(y)](Nominated(y)(y))"
                ],
                "reading": {
                  "section": "3.7"
                }
              },
              {
                "id": "d2",
                "sentence": "She smiled.",
                "tree": "[.VP she_y smiled ]",
                "targets": [
                  "Smiled(y)"
                ],
                "reading": {
                  "section": "3.7"
                }
              }
            ]
          },
          {
            "id": "E",
            "title": "E. An object determiner phrase left in place (§3.3)",
            "instructions": "This tree is the base structure of Jack met every actor who Sue likes, with the determiner phrase in object position. Every rule is refused at the node above met. Read the reason given for each.",
            "derivations": [
              {
                "id": "d1",
                "sentence": "Jack met every actor who Sue likes.",
                "tree": "[.VP Jack [.V′ met [.DP every_z [.NP actor [.CP who_x [.VP Sue [.V′ likes x ] ] ] ] ] ] ]",
                "reading": {
                  "section": "3.3"
                }
              }
            ]
          }
        ]
      }
