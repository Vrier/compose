import Linglib.Semantics.Composition.Rules
import Linglib.Semantics.Composition.Sorts
import Studies.HeimKratzer1998
import ComposeLean.LibPairs

/-!
# Rule oracle for COMPOSE

For every pair of sister types, the binary rules that Linglib's definitions admit and the type
each gives the mother: Functional Application in either order (`Interpreter.Application.rules`),
Predicate Modification (`Interpreter.PredicateModification.rules`), Heim and Kratzer's
Intensional Functional Application (`HeimKratzer1998.IntensionalApplication.rules`) and Kratzer's
Event Identification over individuals and eventualities (`Interpreter.EventIdentification.rules`).
No rule is restated here: every row is computed by Linglib's own `rules` functions.

`ComposeLean/LibPairs.lean` is generated by `regenerate.mjs` from the sister types that occur in
COMPOSE's curated library.

Output, written to the working directory: `oracle-grid.jsonl` and `oracle-lib.jsonl`, one JSON
object per line, `{"l":…,"r":…,"rules":[[tag,mother],…]}`, with types in COMPOSE's notation.
-/

open Interpreter

namespace ComposeOracle

/-- A type in COMPOSE's notation, `<e,t>`. -/
partial def tyStr : Ty Base → String
  | .t => "t"
  | .base .e => "e"
  | .base .s => "s"
  | .base .v => "v"
  | .base .n => "n"
  | .base .d => "d"
  | .fn a b => "<" ++ tyStr a ++ "," ++ tyStr b ++ ">"
  | .comp _ _ => "?"

/-- The base sorts COMPOSE and Linglib share, with the truth values. -/
def atoms : List (Ty Base) := [.t, Ty.e, Ty.s, Ty.v, Ty.n]

/-- Every type of size at most five over the shared sorts. -/
def grid : List (Ty Base) :=
  let s3 := atoms.flatMap fun a ↦ atoms.map fun b ↦ Ty.fn a b
  let s5 := (atoms.flatMap fun a ↦ s3.map fun b ↦ Ty.fn a b) ++
    (s3.flatMap fun a ↦ atoms.map fun b ↦ Ty.fn a b)
  atoms ++ s3 ++ s5

def appTag : {l r u : Ty Base} → Application l r u → String
  | _, _, _, .fa => "fa"
  | _, _, _, .ba => "ba"

def ifaTag : {l r u : Ty Base} → HeimKratzer1998.IntensionalApplication l r u → String
  | _, _, _, .ifa => "ifa"
  | _, _, _, .iba => "iba"

def q (s : String) : String := "\"" ++ s ++ "\""

def cell (tag : String) (u : Ty Base) : String := "[" ++ q tag ++ "," ++ q (tyStr u) ++ "]"

/-- The rules Linglib admits for sisters of types `l` and `r`, as one JSON line. -/
def row (l r : Ty Base) : String :=
  let app := (Application.rules l r).map fun ⟨u, m⟩ ↦ cell (appTag m) u
  let pm := (PredicateModification.rules l r).map fun ⟨u, _⟩ ↦ cell "pm" u
  let ifa := (HeimKratzer1998.IntensionalApplication.rules l r).map fun ⟨u, m⟩ ↦ cell (ifaTag m) u
  let ei := (EventIdentification.rules Ty.e Ty.v l r).map fun ⟨u, _⟩ ↦ cell "ei" u
  "{\"l\":" ++ q (tyStr l) ++ ",\"r\":" ++ q (tyStr r) ++ ",\"rules\":[" ++
    ",".intercalate (app ++ pm ++ ifa ++ ei) ++ "]}"

def gridPairs : List (Ty Base × Ty Base) := grid.flatMap fun l ↦ grid.map fun r ↦ (l, r)

end ComposeOracle

open ComposeOracle in
#eval show IO Unit from do
  IO.FS.writeFile "oracle-grid.jsonl" ("\n".intercalate (gridPairs.map fun (l, r) ↦ row l r))
  IO.FS.writeFile "oracle-lib.jsonl" ("\n".intercalate (libPairs.map fun (l, r) ↦ row l r))
  IO.println s!"grid types {grid.length}, grid pairs {gridPairs.length}, library pairs {libPairs.length}"
